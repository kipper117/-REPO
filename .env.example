# 실제 값은 .env 파일(로컬, git에 커밋 금지)이나 GitHub Secrets에 넣는다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FRED_API_KEY=
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
# 선택: Claude 모델 지정 (기본값: claude-sonnet-5)
CLAUDE_MODEL=
# 선택: 구글 스프레드시트 자동 기록 (둘 다 없으면 이 기능만 건너뜀)
# GOOGLE_SERVICE_ACCOUNT_JSON 값은 서비스 계정 JSON 키 파일 "전체 내용"을 한 줄로 넣는다.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
